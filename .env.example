# ==============================================================================
# gaweb - Konfigurasi Lingkungan (Environment Variables)
# Salin file ini menjadi .env.local untuk pengujian lokal,
# dan masukkan variabel ini ke Settings -> Environment Variables di dashboard Vercel.
# ==============================================================================

# 1. Autentikasi Admin gaweb
ADMIN_PASSWORD=gaweb2026!

# 2. Kontak WhatsApp Resmi (Format: 628xxx)
NEXT_PUBLIC_WA_NUMBER=62881036657944

# 3. Cloudflare R2 Object Storage (Penyimpanan Gambar Permanen & Cepat)
# Cara mendapatkan: Masuk ke dash.cloudflare.com -> R2 Object Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=gaweb-assets
R2_PUBLIC_URL=https://pub-yourbucketid.r2.dev
