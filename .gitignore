*.tsbuildinfo

# Debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Environment variables & secrets
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Vercel
.vercel

# Testing & Coverage
/coverage

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

